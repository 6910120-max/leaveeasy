// ─────────────────────────────────────────────────────────────
// firestore.rules — กฎขั้นต่ำของสัปดาห์ที่ 7: "ต้องล็อกอินก่อน ถึงจะอ่าน/เขียนอะไรได้"
//
// ยังไม่ใช่กฎรายห้อง (แยกตาม role / เจ้าของเอกสาร) — กฎแบบนั้นมาสัปดาห์ที่ 8
// ตาม leaveeasy-spec.md หัวข้อ 0.2 และ ACL.md
//
// ⚠️ ไฟล์นี้ยังไม่ได้ deploy — แค่เขียนไว้ให้อ่านตรวจก่อน
// ─────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ครอบคลุมทุกโฟลเดอร์ ทุกเอกสาร ทุกระดับ (รวม leaveRequests/{id}/approvals ด้วย
    // เพราะ {document=**} หมายถึง "ทุกเส้นทางที่เหลือ ไม่ว่าจะลึกแค่ไหน")
    match /{document=**} {

      // 🔑 บรรทัดนี้คือ "ต้องล็อกอินก่อน":
      // request.auth คือข้อมูลผู้ใช้ที่ Firebase Authentication ยืนยันมาให้พร้อมกับคำขอ
      // ถ้ายังไม่ได้ล็อกอิน request.auth จะเป็น null เสมอ เงื่อนไขนี้เลยเป็นเท็จ อ่าน/เขียนไม่ได้
      allow read, write: if request.auth != null;
    }
  }
}
